# Server Environment Variables — Example / Template
# Copy this file to .env and fill in the real values.

# --- App ---
PORT=5000
NODE_ENV=development

# --- Neon PostgreSQL ---
# Use the connection string provided by your Neon project.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- Authentication ---
# Generate independent random secrets (at least 32 characters each).
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CORS ---
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8098,http://localhost:19006

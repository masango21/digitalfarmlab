# Mobile Environment Variables — Example / Template
# Copy this file to .env and fill in the real values.
# Variables MUST be prefixed with EXPO_PUBLIC_ to be accessible in the app bundle.

# --- API ---
# Base URL of the DigitalFarmLab server (no trailing slash)
# Use your computer's LAN IP when testing on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:5000
